{
  "rules": {
    "appData": {
      ".read": "auth != null",
      ".write": "auth.provider === 'password'",
      "genyakubu-biweekly-base": {
        ".validate": "newData.isString() && newData.val().length < 20"
      },
      "builder": {
        "schedule_project": {
          ".validate": "newData.isString()"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
